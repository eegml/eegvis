        "T3-O1"
      ],
      "color": "#1f4e79",
      "gap_after_mm": 2.0
    },
    {
      "name": "right_temporal",
      "channels": [
        "Fp2-T4",
        "T4-O2"
      ],
      "color": "#a8323e",
      "gap_after_mm": 5.0
