          "T3",
          "T5"
        ]
      },
      {
        "label": "T5-O1",
        "diffpair": [
          "T5",
          "O1"
        ]
      },
      {
        "label": "O1-O2",
        "diffpair": [
          "O1",
          "O2"
        ]
      },
      {
        "label": "O2-T6",
        "diffpair": [
          "O2",
          "T6"
        ]
      },
      {
        "label": "T6-T4",
